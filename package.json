{
  "name": "json-to-resume",
  "version": "2.3.1",
  "description": "A tool to generate the resume.",
  "author": {
    "name": "Cheng",
    "email": "mazeyqian@gmail.com",
    "url": "https://github.com/chengchuu"
  },
  "private": false,
  "scripts": {
    "dev": "vite",
    "e2e:install": "playwright install chromium",
    "build": "cross-env BASE_PATH=/ node build/build.js",
    "build:pages": "cross-env BASE_PATH=/json-to-resume/ node build/build.js",
    "validate:pages": "node scripts/validate-pages.js",
    "test:node": "node --test test/node/pages-path.spec.js",
    "unit": "vitest run --coverage",
    "e2e": "playwright test",
    "test": "npm run test:node && npm run unit && npm run e2e",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "cross-env BASE_PATH=/ vite preview",
    "preview:pages": "cross-env BASE_PATH=/json-to-resume/ vite preview",
    "e2e:preview": "cross-env E2E_MODE=preview playwright test",
    "e2e:pages": "cross-env E2E_MODE=pages playwright test"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@html-eslint/eslint-plugin": "^0.47.0",
    "@html-eslint/parser": "^0.47.0",
    "@playwright/test": "1.55.0",
    "@stylistic/eslint-plugin": "^4.4.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "^16.1.5",
    "mazey": "^5.9.1",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "7.1.1",
    "sass": "1.77.8",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,vue,html}": "eslint --fix"
  }
}
